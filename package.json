{
  "name": "shikiform-monorepo",
  "private": true,
  "description": "ShikiForm workspace. Publishable packages: @shikiform/core, @shikiform/react, @shikiform/hooks, @shikiform/antd.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run check:docs && node scripts/ensure-site-deps.mjs && npm run build --prefix docs-site",
    "build:cf-pages": "npm run build",
    "build:lib": "npm run build -w @shikiform/core && npm run build -w @shikiform/react && npm run build -w @shikiform/hooks && npm run build -w @shikiform/antd && tsc -p tsconfig.emit.json --noEmit",
    "build:play": "vite build --config playground/vite.config.ts",
    "check": "tsc --noEmit",
    "check:docs": "npm run check:api && npm run build:lib && node scripts/check-docs-package.mjs",
    "check:api": "node scripts/check-api-reference.mjs",
    "dev": "npm run build:lib && node scripts/ensure-site-deps.mjs && npm run dev --prefix docs-site",
    "dev:e2e": "vite --config playground/vite.config.ts",
    "preview": "npm run preview --prefix docs-site --",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:site": "npm run lint:docs --prefix docs-site"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.56.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "happy-dom": "^20.14.6",
    "immer": "^11.2.9",
    "jsdom": "^29.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sucrase": "^3.35.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "valibot": "^1.2.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "zod": "^4.1.12"
  }
}
