{
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/starlight": "^0.42.7",
    "@tanstack/react-virtual": "^3.13.12",
    "antd": "^5.27.4",
    "astro": "^7.4.2",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "description": "ShikiForm — JSX structure, draft + $ state, reaction / watch. Core, headless React, and an Ant Design binding.",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "valibot": "^1.2.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "name": "shikiform",
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "private": true,
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.js"
    },
    "./pro": {
      "types": "./lib/pro/index.d.ts",
      "import": "./lib/pro/index.js",
      "default": "./lib/pro/index.js"
    },
    "./antd": {
      "types": "./lib/antd/index.d.ts",
      "import": "./lib/antd/index.js",
      "default": "./lib/antd/index.js"
    }
  },
  "scripts": {
    "build": "astro build && vite build --config playground/vite.config.ts",
    "build:cf-pages": "npm run build",
    "build:lib": "tsup && tsc -p tsconfig.emit.json --noEmit",
    "check": "tsc --noEmit",
    "dev": "astro dev",
    "dev:e2e": "vite --config playground/vite.config.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "type": "module",
  "version": "0.1.0"
}
