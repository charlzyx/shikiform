{
  "name": "shikiform",
  "version": "0.1.0",
  "private": true,
  "description": "ShikiForm — JSX structure, draft + $ state, reaction / watch. Rspress docs plus the library (core, headless React, Ant Design).",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.js"
    },
    "./pro": {
      "types": "./lib/pro/index.d.ts",
      "import": "./lib/pro/index.js",
      "default": "./lib/pro/index.js"
    },
    "./antd": {
      "types": "./lib/antd/index.d.ts",
      "import": "./lib/antd/index.js",
      "default": "./lib/antd/index.js"
    }
  },
  "scripts": {
    "build": "rspress build",
    "build:cf-pages": "rspress build",
    "build:lib": "tsup && tsc -p tsconfig.emit.json --noEmit",
    "build:play": "vite build --config playground/vite.config.ts",
    "check": "tsc --noEmit",
    "dev": "rspress dev",
    "dev:e2e": "vite --config playground/vite.config.ts",
    "preview": "rspress preview",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:play && playwright test"
  },
  "dependencies": {
    "@live-demo/rspress": "^3.0.2",
    "@rspress/core": "^2.0.23",
    "@rspress/plugin-preview": "^2.0.23",
    "@tanstack/react-virtual": "^3.13.12",
    "antd": "^5.29.3",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "valibot": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "antd": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
