{
  "name": "shikiform",
  "version": "0.1.0",
  "private": true,
  "description": "ShikiForm — one headless form engine, React bindings and Ant Design adapters. VitePress documentation with same-source React examples.",
  "type": "module",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.js"
    },
    "./pro": {
      "types": "./lib/pro/index.d.ts",
      "import": "./lib/pro/index.js",
      "default": "./lib/pro/index.js"
    },
    "./antd": {
      "types": "./lib/antd/index.d.ts",
      "import": "./lib/antd/index.js",
      "default": "./lib/antd/index.js"
    }
  },
  "scripts": {
    "build": "npm run check:docs && vitepress build site && npm run build:play && node scripts/check-site.mjs",
    "build:cf-pages": "npm run build",
    "build:lib": "tsup && tsc -p tsconfig.emit.json --noEmit",
    "build:play": "vite build --config playground/vite.config.ts",
    "check": "tsc --noEmit",
    "check:docs": "npm run check:api && npm run build:lib && node scripts/check-docs-package.mjs",
    "check:api": "node scripts/check-api-reference.mjs",
    "dev": "npm run build:lib && vitepress dev site",
    "dev:e2e": "vite --config playground/vite.config.ts",
    "preview": "vitepress preview site",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check:site": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@live-demo/rspress": "3.0.2",
    "@tanstack/react-virtual": "^3.13.12",
    "antd": "^5",
    "immer": "^11.2.9",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@codemirror/view": "6.43.15",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "jsdom": "^29.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "valibot": "^1.2.0",
    "vite": "^6.4.1",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "antd": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  }
}
