{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "shikiform/antd": [
        "src/antd/index.ts"
      ],
      "shikiform/core": [
        "src/core/index.ts"
      ],
      "shikiform/pro": [
        "src/pro/index.ts"
      ],
      "shikiform": [
        "src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    ".astro",
    "archive",
    "docs",
    "site/generated",
    "site/.vitepress/cache"
  ],
  "include": [
    "src/**/*",
    "tests/**/*",
    "playground/**/*",
    "e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "site/**/*.ts",
    "site/**/*.tsx"
  ]
}
