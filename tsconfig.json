{
  "compilerOptions": {
    "baseUrl": ".",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "shikiform/antd": [
        "src/antd/index.ts"
      ],
      "shikiform/core": [
        "src/core/index.ts"
      ],
      "shikiform/pro": [
        "src/pro/index.ts"
      ],
      "shikiform": [
        "src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "vite/client"
    ],
    // vitest.config / 测试从 docs-site 引插件和源码，virtual 模块声明在站点里。
    "rootDirs": [
      ".",
      "docs-site"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    ".astro",
    "archive",
    "docs",
    // 站点有自己的 astro check（根 tsc 不认识 .astro / virtual 模块）。
    "docs-site"
  ],
  "include": [
    "src/**/*",
    "tests/**/*",
    "playground/**/*",
    "e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts",
    "virtual.d.ts"
  ]
}
