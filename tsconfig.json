{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "shikiform/antd": ["src/antd/index.ts"],
      "shikiform/core": ["src/core/index.ts"],
      "shikiform/pro": ["src/pro/index.ts"],
      "shikiform": ["src/index.ts"]
    },
    "types": [
      "node",
      "astro/client"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    ".astro",
    "usage"
  ],
  "include": [
    "src/**/*",
    "tests/**/*",
    "playground/**/*",
    "e2e/**/*",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
