---
// 从 usage 源码里抽出所有 ❓ 注释（含续行），单一来源 = usage/*.tsx
// 续行规则：`//` 后至少 2 个空格的注释行；或 JSX 块注释 {/* ... */} 未闭合前的行。
interface Props { code: string }
const lines = Astro.props.code.split('\n');
const clean = (s: string) => s.replace(/\*\/\}?\s*$/, '').replace(/^\/\/\s*/, '').trim();
const points: { line: number; text: string }[] = [];
for (let i = 0; i < lines.length; i++) {
  const l = lines[i];
  const at = l.indexOf('❓');
  if (at < 0) continue;
  const parts = [clean(l.slice(at + 1))];
  let inBlock = l.includes('/*') && !l.includes('*/');
  for (let j = i + 1; j < lines.length; j++) {
    const t = lines[j].trim();
    if (t.includes('❓')) break;
    if (inBlock) {
      parts.push(clean(t));
      if (t.includes('*/')) break;
      continue;
    }
    if (/^\/\/\s{2,}\S/.test(t)) { parts.push(clean(t)); continue; }
    break;
  }
  points.push({ line: i + 1, text: parts.filter(Boolean).join(' ') });
}
---
{points.length === 0 ? <p>本用例没有标记 ❓。</p> : (
  <ul>
    {points.map((p) => <li><code>L{p.line}</code> {p.text}</li>)}
  </ul>
)}
