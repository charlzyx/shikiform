---
/* The site's logo, inline so it takes the text colour in light and dark. The
   drawing lives in logo.ts, which the social cards read too. */
import { logo } from "./logo";

interface Props { class?: string }
// Callers give it a whole-pixel box and the drawing centres inside.
const { class: cls = "h-5 w-5" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${logo.width} ${logo.height}`} class={cls} aria-hidden="true">
  {logo.paths.map((d, index) => (
    <path
      d={d}
      fill={index === 0 || index === logo.paths.length - 1 ? "var(--sf-cinnabar, var(--nb-brand, currentColor))" : "currentColor"}
    />
  ))}
</svg>
