---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { getNavCatalog } from "@/lib/nav-catalog";

const { groups, items } = getNavCatalog(import.meta.env.BASE_URL);
---

<dialog
  id="sf-cmd-palette"
  data-sf-cmd-palette
  aria-label="快捷指令面板"
  class="sf-overlay-dialog"
>
  <div class="sf-cmd-box">
    <!-- 顶部搜索输入 + 分组筛选条（Niko 同款布局） -->
    <div class="sf-cmd-head">
      <div class="sf-cmd-input-row">
        <Icon name="ph:magnifying-glass" class="w-4 h-4 shrink-0 text-brand" />
        <input
          type="text"
          data-sf-cmd-input
          placeholder="输入文档名称、所属模块或路径快速检索..."
          autocomplete="off"
          spellcheck="false"
          class="sf-cmd-input"
        />
        <kbd class="sf-cmd-esc">ESC</kbd>
      </div>

      <div class="sf-cmd-tabs-row">
        <div class="sf-cmd-tabs" role="tablist" aria-label="按模块筛选">
          <button
            type="button"
            role="tab"
            data-sf-cmd-tab="all"
            aria-selected="true"
            class="sf-cmd-tab is-selected"
          >
            全部 ({items.length})
          </button>
          {groups.map((g) => (
            <button
              type="button"
              role="tab"
              data-sf-cmd-tab={g.key}
              aria-selected="false"
              class="sf-cmd-tab"
            >
              {g.label}
            </button>
          ))}
        </div>
        <span class="sf-cmd-count" data-sf-cmd-count>
          匹配 {items.length} 项
        </span>
      </div>
    </div>

    <!-- 3 列高密度卡片网格 -->
    <div class="sf-cmd-body" data-sf-cmd-body>
      <div class="sf-cmd-grid" data-sf-cmd-grid>
        {items.map((item, idx) => (
          <a
            href={item.href}
            data-sf-cmd-item
            data-group={item.groupKey}
            data-search={`${item.label} ${item.groupLabel} ${item.path}`.toLowerCase()}
            data-label={item.label}
            data-group-label={item.groupLabel}
            data-path={item.path}
            class:list={["sf-cmd-card", idx === 0 && "is-active"]}
          >
            <span class="sf-cmd-card-bar" aria-hidden="true" />
            <div class="sf-cmd-card-title">{item.label}</div>
            <div class="sf-cmd-card-meta">
              {item.groupLabel} · {item.path}
            </div>
          </a>
        ))}
      </div>
      <div class="sf-cmd-empty" data-sf-cmd-empty hidden>
        未找到匹配的文档入口
      </div>
    </div>

    <!-- 底部方向键操作说明 -->
    <div class="sf-cmd-foot">
      <span>方向键 ↑ ↓ ← → 移动焦点 · Enter 立即进入</span>
      <span>⌘K 快捷面板</span>
    </div>
  </div>
</dialog>

<script>
  const RECENT_KEY = "sf-recent-visits-v1";

  function recordRecentVisit(entry: { path: string; href: string; label: string; groupLabel: string }) {
    try {
      const raw = localStorage.getItem(RECENT_KEY);
      const list: Array<typeof entry> = raw ? JSON.parse(raw) : [];
      const next = [entry, ...list.filter((i) => i.path !== entry.path)].slice(0, 8);
      localStorage.setItem(RECENT_KEY, JSON.stringify(next));
      window.dispatchEvent(new CustomEvent("sf:recent-updated"));
    } catch {
      // ignore storage errors
    }
  }

  function initCommandPalette() {
    const dialog = document.querySelector<HTMLDialogElement>("[data-sf-cmd-palette]");
    if (!dialog || dialog.dataset.sfBound === "1") return;
    dialog.dataset.sfBound = "1";

    const input = dialog.querySelector<HTMLInputElement>("[data-sf-cmd-input]")!;
    const countEl = dialog.querySelector<HTMLElement>("[data-sf-cmd-count]")!;
    const emptyEl = dialog.querySelector<HTMLElement>("[data-sf-cmd-empty]")!;
    const tabs = Array.from(dialog.querySelectorAll<HTMLButtonElement>("[data-sf-cmd-tab]"));
    const cards = Array.from(dialog.querySelectorAll<HTMLAnchorElement>("[data-sf-cmd-item]"));

    let activeGroup = "all";
    let visibleCards: HTMLAnchorElement[] = [...cards];
    let activeIndex = 0;

    function getCols() {
      if (window.innerWidth >= 768) return 3;
      if (window.innerWidth >= 640) return 2;
      return 1;
    }

    function setActive(index: number, scroll = false) {
      for (const c of visibleCards) c.classList.remove("is-active");
      if (visibleCards.length === 0) {
        activeIndex = 0;
        return;
      }
      activeIndex = ((index % visibleCards.length) + visibleCards.length) % visibleCards.length;
      const target = visibleCards[activeIndex];
      target.classList.add("is-active");
      if (scroll) {
        target.scrollIntoView({ block: "nearest" });
      }
    }

    function applyFilter() {
      const q = input.value.trim().toLowerCase();
      visibleCards = [];
      for (const card of cards) {
        const groupMatch = activeGroup === "all" || card.dataset.group === activeGroup;
        const textMatch = !q || (card.dataset.search ?? "").includes(q);
        const show = groupMatch && textMatch;
        card.hidden = !show;
        if (show) visibleCards.push(card);
      }
      countEl.textContent = `匹配 ${visibleCards.length} 项`;
      emptyEl.hidden = visibleCards.length > 0;
      setActive(0);
    }

    function openPalette() {
      const menuDialog = document.querySelector<HTMLDialogElement>("[data-sf-menu-map]");
      if (menuDialog?.open) menuDialog.close();
      if (!dialog.open) {
        dialog.showModal();
      }
      input.value = "";
      activeGroup = "all";
      for (const t of tabs) {
        const sel = t.dataset.sfCmdTab === "all";
        t.classList.toggle("is-selected", sel);
        t.setAttribute("aria-selected", String(sel));
      }
      applyFilter();
      requestAnimationFrame(() => input.focus());
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        activeGroup = tab.dataset.sfCmdTab ?? "all";
        for (const t of tabs) {
          const sel = t === tab;
          t.classList.toggle("is-selected", sel);
          t.setAttribute("aria-selected", String(sel));
        }
        applyFilter();
        input.focus();
      });
    });

    input.addEventListener("input", applyFilter);

    input.addEventListener("keydown", (e) => {
      const len = visibleCards.length;
      if (!len) return;
      const cols = getCols();

      if (e.key === "ArrowRight") {
        e.preventDefault();
        setActive(activeIndex + 1, true);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        setActive(activeIndex - 1, true);
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIndex + cols < len ? activeIndex + cols : activeIndex % cols, true);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        if (activeIndex - cols >= 0) {
          setActive(activeIndex - cols, true);
        } else {
          const col = activeIndex % cols;
          const lastRowStart = Math.floor((len - 1) / cols) * cols;
          setActive(Math.min(len - 1, lastRowStart + col), true);
        }
      } else if (e.key === "Enter") {
        e.preventDefault();
        const target = visibleCards[activeIndex];
        if (target) {
          recordRecentVisit({
            path: target.dataset.path ?? "",
            href: target.getAttribute("href") ?? "/",
            label: target.dataset.label ?? "",
            groupLabel: target.dataset.groupLabel ?? "",
          });
          dialog.close();
          target.click();
        }
      }
    });

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        const idx = visibleCards.indexOf(card);
        if (idx >= 0) setActive(idx, false);
      });
      card.addEventListener("click", () => {
        recordRecentVisit({
          path: card.dataset.path ?? "",
          href: card.getAttribute("href") ?? "/",
          label: card.dataset.label ?? "",
          groupLabel: card.dataset.groupLabel ?? "",
        });
        dialog.close();
      });
    });

    // Click backdrop to close
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Bind all triggers & Cmd/Ctrl+K
    if (!(window as any).__sfCmdGlobalBound) {
      (window as any).__sfCmdGlobalBound = true;
      document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement | null)?.closest("[data-search-trigger]");
        if (trigger) {
          e.preventDefault();
          document.dispatchEvent(new CustomEvent("sf:open-cmd-palette"));
        }
      });
      window.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          const d = document.querySelector<HTMLDialogElement>("[data-sf-cmd-palette]");
          if (d?.open) d.close();
          else document.dispatchEvent(new CustomEvent("sf:open-cmd-palette"));
        }
      });
    }

    document.addEventListener("sf:open-cmd-palette", openPalette);
  }

  initCommandPalette();
  document.addEventListener("astro:page-load", initCommandPalette);
</script>

<style>
  .sf-overlay-dialog {
    padding: 0;
    margin: 56px auto 0;
    width: min(820px, calc(100vw - 24px));
    max-width: none;
    max-height: calc(100vh - 80px);
    border: 1px solid var(--nb-border);
    border-radius: 10px;
    background: var(--nb-card);
    color: var(--nb-foreground);
    box-shadow: 0 24px 64px -16px rgba(20, 19, 26, 0.28);
    overflow: hidden;
  }
  :global([data-mode="dark"]) .sf-overlay-dialog {
    box-shadow: 0 28px 72px -12px rgba(0, 0, 0, 0.65);
  }
  .sf-overlay-dialog::backdrop {
    background: rgba(20, 19, 26, 0.42);
    backdrop-filter: blur(3px);
  }
  .sf-cmd-box {
    display: flex;
    flex-direction: column;
    user-select: none;
  }
  .sf-cmd-head {
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--nb-border);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sf-cmd-input-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sf-cmd-input {
    flex: 1;
    min-width: 0;
    font-size: 14px;
    color: var(--nb-foreground);
    background: transparent;
    border: 0;
    outline: none;
  }
  .sf-cmd-input::placeholder {
    color: var(--nb-muted-foreground);
  }
  .sf-cmd-esc {
    padding: 2px 6px;
    font-family: var(--nb-font-mono);
    font-size: 11px;
    color: var(--nb-muted-foreground);
    border: 1px solid var(--nb-border);
    border-radius: 4px;
    background: var(--nb-muted);
  }
  .sf-cmd-tabs-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .sf-cmd-tabs {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .sf-cmd-tab {
    padding: 2px 10px;
    font-size: 12px;
    line-height: 20px;
    border-radius: 4px;
    border: 1px solid transparent;
    background: var(--nb-muted);
    color: var(--nb-muted-foreground);
    cursor: pointer;
    transition: all 0.14s ease;
  }
  .sf-cmd-tab:hover {
    color: var(--nb-foreground);
    background: var(--nb-accent);
  }
  .sf-cmd-tab.is-selected {
    border-color: color-mix(in srgb, var(--nb-brand) 38%, transparent);
    background: var(--nb-brand-wash);
    color: var(--nb-brand);
    font-weight: 600;
  }
  .sf-cmd-count {
    font-size: 12px;
    color: var(--nb-muted-foreground);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sf-cmd-body {
    max-height: 420px;
    overflow-y: auto;
    padding: 12px;
  }
  .sf-cmd-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }
  @media (max-width: 767px) {
    .sf-cmd-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .sf-cmd-grid {
      grid-template-columns: 1fr;
    }
  }
  .sf-cmd-card {
    position: relative;
    display: block;
    padding: 8px 12px;
    border-radius: 5px;
    border: 1px solid var(--nb-border);
    background: var(--nb-background);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.14s ease, border-color 0.14s ease;
  }
  .sf-cmd-card[hidden] {
    display: none;
  }
  .sf-cmd-card:hover {
    border-color: color-mix(in srgb, var(--nb-brand) 42%, transparent);
    background: var(--nb-muted);
  }
  .sf-cmd-card.is-active {
    border-color: color-mix(in srgb, var(--nb-brand) 48%, transparent);
    background: var(--nb-brand-wash);
  }
  .sf-cmd-card-bar {
    display: none;
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 3px;
    border-radius: 0 2px 2px 0;
    background: var(--nb-brand);
  }
  .sf-cmd-card.is-active .sf-cmd-card-bar {
    display: block;
  }
  .sf-cmd-card-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--nb-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sf-cmd-card.is-active .sf-cmd-card-title {
    color: var(--nb-brand);
    font-weight: 600;
  }
  .sf-cmd-card-meta {
    margin-top: 2px;
    font-size: 11px;
    color: var(--nb-muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sf-cmd-empty {
    padding: 44px 0;
    text-align: center;
    font-size: 13px;
    color: var(--nb-muted-foreground);
  }
  .sf-cmd-foot {
    padding: 8px 14px;
    border-top: 1px solid var(--nb-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
    color: var(--nb-muted-foreground);
  }
</style>
