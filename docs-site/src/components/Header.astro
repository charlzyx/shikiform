---
import { pageLanguage, languagePath, englishLabel } from "@/lib/language";
import Logo from "./Logo.astro";
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { getCollectionUrl, getSidebarSections, stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const language = pageLanguage(Astro.url.pathname);
const english = language === "en";
const currentSlug = languagePath(stripBase(Astro.url.pathname, import.meta.env.BASE_URL), "zh-CN").replace(/\/$/, "") || "/";
const sidebarSections =
  sectionsProp ?? (await getSidebarSections(currentSlug, { collection }));
// An API reference beside the docs isn't in the docs sidebar, so the docs and
// each reference become the tabs. A reference served at the root is the site.
const apiHrefs = (
  await Promise.all((config.api ?? []).map(async (entry) => ({ entry, href: await getCollectionUrl(entry.collection) })))
).filter(({ href }) => href !== "/");
// The reference the page is in: the longest mount that is the path or a folder of it.
const mountOf = (href: string) => href.replace(/\/$/, "");
const activeApi = apiHrefs
  .filter(({ href }) => currentSlug === mountOf(href) || currentSlug.startsWith(`${mountOf(href)}/`))
  .sort((a, b) => b.href.length - a.href.length)[0];
const sections =
  sidebarSections.length >= 2 || sectionsProp || apiHrefs.length === 0
    ? sidebarSections
    : [
        // A page outside every collection (the 404) is in neither tab.
        { label: "Docs", href: "/", isActive: activeApi === undefined && collection !== undefined },
        ...apiHrefs.map((api) => ({
          label: apiHrefs.length === 1 ? "API reference" : (api.entry.label ?? api.entry.collection),
          href: api.href,
          isActive: api === activeApi,
        })),
      ];
const showSections = sections.length >= 2;
const homeHref = withBase(languagePath("/", language), import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string =>
  withBase(languagePath(href, language), import.meta.env.BASE_URL);

const primaryNav = [
  {
    label: "指南",
    href: "/guide/quick-start",
    isActive:
      currentSlug.startsWith("/guide") ||
      currentSlug.startsWith("/basics") ||
      currentSlug.startsWith("/advanced") ||
      currentSlug.startsWith("/practices"),
  },
  {
    label: "教程",
    href: "/tutorial/1-start",
    isActive: currentSlug.startsWith("/tutorial"),
  },
  {
    label: "示例",
    href: "/examples",
    isActive: currentSlug.startsWith("/examples") || currentSlug.startsWith("/play"),
  },
  {
    label: "API",
    href: "/api",
    isActive: currentSlug.startsWith("/api") || currentSlug.startsWith("/reference"),
  },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-card/85 backdrop-blur-lg">
  <div class="sf-header-bar mx-auto flex items-center justify-between gap-1 sm:gap-4 h-12 px-2 sm:px-4 lg:px-6">
    <div class="sf-header-brand flex items-center gap-3 min-w-0">
      <slot name="brand">
        <a href={homeHref} class="group flex shrink-0 items-center gap-2.5 text-foreground no-underline transition-opacity hover:opacity-85">
          <Logo class="h-5 w-5 shrink-0" />
          <span class="font-display text-[1.0625rem] font-extrabold tracking-[-0.02em] leading-none">
            {config.title}
          </span>
          <span
            aria-hidden="true"
            class="inline-flex items-center justify-center w-[18px] h-[18px] rounded-[3px] text-[11px] font-bold leading-none text-[#fcfbf7]"
            style="background: var(--sf-cinnabar, #c34435);"
          >式</span>
        </a>
      </slot>

      <nav aria-label={english ? "Main navigation" : "主导航"} class="hidden md:flex items-center gap-1 ms-3 ps-4 border-s border-border h-6 min-w-0">
        {primaryNav.map((item) => (
          <a
            href={resolveSectionHref(item.href)}
            aria-current={item.isActive ? "page" : undefined}
            class:list={[
              "px-2.5 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
              item.isActive
                ? "text-brand bg-brand/10"
                : "text-muted-foreground hover:text-foreground hover:bg-accent/70",
            ]}
          >
            {english ? englishLabel(item.label) : item.label}
          </a>
        ))}
      </nav>

      {showSections && (
        <nav aria-label={english ? "Sections" : "文档分区"} class="hidden md:flex items-center gap-1 ms-4 ps-4 border-s border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              class:list={[
                "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
                section.isActive
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="sf-header-actions flex items-center gap-0.5 sm:gap-2 shrink-0">
      <slot name="actions" />
      <a href={languagePath(currentSlug, english ? "zh-CN" : "en")} lang={english ? "zh-CN" : "en"}
        hreflang={english ? "zh-CN" : "en"} aria-label={english ? "切换到简体中文" : "Switch to English"} class="whitespace-nowrap text-sm font-medium hover:underline">
        <span class="hidden md:inline">{english ? "简体中文" : "English"}</span>
        <span class="md:hidden">{english ? "中文" : "EN"}</span>
      </a>
      <button
        type="button"
        data-sf-menu-map-trigger
        class="px-2.5 py-1.5 rounded-md text-[0.8125rem] font-medium text-muted-foreground hover:text-foreground hover:bg-accent/70 transition-colors cursor-pointer shrink-0 whitespace-nowrap"
        aria-label={english ? "Open the documentation directory" : "打开文档目录总览"}
      >
        <Icon name="ph:list-dashes" class="h-5 w-5 md:hidden" />
        <span class="hidden md:inline">{english ? "Directory" : "目录"}</span>
      </button>
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={english ? "Open navigation" : "打开导航"}
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
  {/* Phones: the tabs on a row of their own under the bar. */}
  {showSections && (
    <nav aria-label={english ? "Sections" : "文档分区"} data-nb-header-tabs class="md:hidden flex items-center gap-1 h-10 px-4 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {sections.map((section) => (
        <a
          href={resolveSectionHref(section.href)}
          aria-current={section.isActive ? "page" : undefined}
          class:list={[
            "px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
            section.isActive
              ? "text-foreground bg-accent"
              : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )}
</header>
