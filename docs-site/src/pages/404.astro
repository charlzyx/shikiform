---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender the 404 so it stays a static route under `output: "server"`.
// Hosts serve it via their not-found handling (e.g. Cloudflare
// `not_found_handling: "404-page"`); the adapter adds no on-demand route.
export const prerender = true;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const playHref = withBase("/play/", import.meta.env.BASE_URL);
---

<BaseLayout title="找不到这一页" description="这个地址没有对应的页面。" noindex>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="flex-1 mx-auto max-w-2xl w-full px-6 py-24 text-center">
      <p class="text-sm font-medium text-muted-foreground">404</p>
      <h1
        id="nb-404-title"
        class="mt-2 text-foreground leading-tight"
        style="font-size: var(--nb-h1-size); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        找不到这一页
      </h1>
      <p id="nb-404-body" class="mt-2 text-[1.0625rem] text-muted-foreground leading-relaxed">
        地址不存在，或者已经挪走了。
      </p>
      <a
        id="nb-404-back"
        href={homeHref}
        class="mt-8 inline-block rounded-lg border border-border px-4 py-2 font-medium text-foreground no-underline transition-colors hover:border-border-strong"
      >
        返回首页
      </a>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ playHref }}>
  const path = location.pathname
  if (path === "/play" || path.startsWith("/play/")) {
    const title = document.getElementById("nb-404-title")
    const body = document.getElementById("nb-404-body")
    const back = document.getElementById("nb-404-back")
    if (title) title.textContent = "没有这个示例"
    if (body) body.textContent = "这个演示地址不存在。"
    if (back instanceof HTMLAnchorElement) {
      back.href = playHref
      back.textContent = "返回示例目录"
    }
  }
</script>
