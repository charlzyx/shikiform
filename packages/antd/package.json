{
  "name": "@shikiform/antd",
  "version": "0.1.0",
  "description": "Ant Design adapter for ShikiForm: FormItem, controls, arrays, and query lists.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shikiform/core": "0.1.0",
    "@shikiform/hooks": "0.1.0",
    "@shikiform/react": "0.1.0"
  },
  "peerDependencies": {
    "antd": "^5.18.0",
    "dayjs": "^1",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "scripts": {
    "build": "tsup"
  }
}
