{
  "name": "@shikiform/react",
  "version": "0.6.1",
  "description": "Headless React bindings for ShikiForm. Re-exports @shikiform/core.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.en.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shikiform/core": "0.6.1",
    "@tanstack/react-virtual": "^3.13.12"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "scripts": {
    "build": "tsup"
  }
}
