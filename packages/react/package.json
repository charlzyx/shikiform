{
  "name": "@shikiform/react",
  "version": "0.8.0",
  "license": "MIT",
  "description": "Headless React bindings for ShikiForm. Re-exports @shikiform/core.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "internal",
    "README.en.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      },
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@shikiform/core": "0.8.0"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17 || ^18 || ^19",
    "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
  },
  "scripts": {
    "build": "tsup"
  }
}
