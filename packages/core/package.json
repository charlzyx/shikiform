{
  "name": "@shikiform/core",
  "version": "0.7.1",
  "license": "MIT",
  "description": "ShikiForm engine: values, draft effects, validation, and tree moves. No React.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.en.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  }
}
